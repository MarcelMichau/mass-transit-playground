<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>9a244cb5-1d15-4c08-94dd-43f32c7490cb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="17.0.0" />
    <!-- Override vulnerable transitive version from Aspire.Hosting.SqlServer (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

  <!-- CodeQL autobuild can invoke dotnet without an Aspire CLI or DNX launcher on PATH. -->
  <Target Name="SetUpAspireCliBundleForGitHubActions"
          BeforeTargets="ResolveAspireCliBundlePaths"
          Condition="'$(GITHUB_ACTIONS)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(AspireCliPath)' == '' and '$(AspireCliBundlePath)' == ''">
    <PropertyGroup>
      <_AspireCliInstallPath>$(ASPIRE_HOME)</_AspireCliInstallPath>
      <_AspireCliInstallPath Condition="'$(_AspireCliInstallPath)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/.aspire</_AspireCliInstallPath>
    </PropertyGroup>
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; tool restore" WorkingDirectory="$(MSBuildProjectDirectory)/.." />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; tool run aspire setup --install-path &quot;$(_AspireCliInstallPath)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)/.." />
  </Target>

</Project>
