<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>9a244cb5-1d15-4c08-94dd-43f32c7490cb</UserSecretsId>
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <!-- The Aspire CLI isn't installed on GitHub Actions runners (e.g. CodeQL autobuild), which fails the build with ASPIRE009 -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.4" />
    <!-- Override vulnerable transitive version from Aspire.Hosting.SqlServer (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaymentApi\PaymentApi.csproj" />
  </ItemGroup>

</Project>
